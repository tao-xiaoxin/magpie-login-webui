{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "skipLibCheck": true,
    "noEmit": true, "jsx": "react-jsx", "strict": true, "verbatimModuleSyntax": true,
    "esModuleInterop": true, "types": ["node"], "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "vite.config.ts"]
}
