# 公开模板，不含任何真实密钥。
# 使用：cp .env.example .env && chmod 600 .env，然后填 3 个空值。
# .env 已被 .gitignore 排除，绝不提交。

# ------------------------------------------------------------------- 必填三项
# 登录密码。只用字母数字，别带空格和分号（它同时也是会话 Cookie 的值）。
MAGPIE_LOGIN_PASSWORD=

# 两个随机值，各跑一次 openssl 填进来：
#   openssl rand -hex 16   → MAGPIE_WEB_KEY   magpie 管理页密钥，nginx 注入上游 Cookie，不给浏览器
#   openssl rand -hex 24   → MAGPIE_API_KEY   客户端调 /v1 用的 Bearer key
# 方式二的 MAGPIE_API_KEY 必须是管理页 Gateway → Gateway keys 里建好并启用的那把
# （sk-magpie-key-…），因为 nginx 会把它原样转发给 magpie，随便编一个上游不认。
MAGPIE_WEB_KEY=
MAGPIE_API_KEY=

# --------------------------------------------------------------- 可选，一般不动
# 登录页用户名。
MAGPIE_LOGIN_USER=admin
# 会话 Cookie 有效期（秒），默认 7 天。
MAGPIE_SESSION_TTL=604800
# 每次访问后续到该时长（秒），等于空闲超时；留空或 0 = 不续期。
MAGPIE_SESSION_RENEW=86400
# 默认只监听宿主机 loopback；要对外改 0.0.0.0，并务必走 HTTPS。
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# magpie 镜像版本，写死版本号。不要用 latest/stable/edge/daily，这些标签会动。
MAGPIE_IMAGE_TAG=0.1.3866
# HTTPS 时填 "; Secure"（含分号与空格），本机 HTTP 验证留空。
MAGPIE_COOKIE_SECURE_FLAG=

# --------------------------------------------------------------- 仅对外时打开
# 对外域名或 IP。不写就按 HTTP_PORT 推成 http://localhost:<port>。
# MAGPIE_LOGIN_ORIGIN=https://你的域名
# HTTPS 端口映射，见 nginx/nginx.conf 末尾的 443 示例。
# HTTPS_BIND=127.0.0.1
# HTTPS_PORT=8443
