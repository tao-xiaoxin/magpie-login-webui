# 运行时不需要的源码与构建中间产物：保留在磁盘，不进仓库。
# 部署只用到 dist/，下面这些目录都不参与运行。
node_modules/
server/
scripts/
tests/
e2e/
dist-server/
test-results/
coverage/
tsconfig.server.json

# 本地配置与凭据，绝不提交。
.env
.env.*
!.env.example
.local/
*.pem
*.key
*.crt
users.json
htpasswd
*.log

# 宿主机形态在服务器项目目录内生成的运行时文件（含明文密钥）
runtime/
bin/
config/
cache/
magpie.pid
magpie.log

# 备份与归档
.backup/
.archive/
backups/

# 系统文件
.DS_Store
__pycache__/

# 前端构建产物由使用者自行构建，不进仓库。
dist/
